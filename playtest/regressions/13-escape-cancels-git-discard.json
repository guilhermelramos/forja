{
  "title": "Escape cancels Git discard confirmation",
  "locale": "pt-BR",
  "steps": [
    { "m": "ui.key", "keys": "Escape" },
    { "m": "ui.click", "target": "Adicionar pasta" },
    { "m": "ui.click", "target": "Escolher…" },
    { "m": "ui.click", "target": "Adicionar" },
    { "m": "ui.open_tab", "target": "Diferenças" },
    { "m": "ui.open_tab", "target": "Mudanças" },
    { "m": "ui.wait", "ms": 1000 },
    { "m": "ui.click", "target": "↺" },
    { "m": "ui.key", "keys": "Escape" },
    { "m": "ui.snapshot" }
  ],
  "expect": [
    { "step": 7, "present": "Descartar mudanças", "present_contains": "src/login.ts", "window_count": 1 },
    { "step": 8, "absent": "Descartar mudanças", "present": "src/login.ts", "window_count": 0 }
  ]
}
