{
  "title": "A view que falha fica em um cartão recuperável (#190)",
  "issue": 190,
  "locale": "pt-BR",
  "test_helpers": "none",
  "steps": [
    {"m": "ui.key", "keys": "Escape"},
    {"m": "ui.click", "target": "Abrir pasta"},
