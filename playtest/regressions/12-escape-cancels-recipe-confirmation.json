{
  "title": "Escape cancels terminal recipe confirmation",
  "locale": "pt-BR",
  "steps": [
    { "m": "ui.key", "keys": "Escape" },
    { "m": "ui.click", "target": "Ajustes" },
    { "m": "ui.type", "text": "rodar" },
    { "m": "ui.click", "target": "Confirmar antes de rodar" },
    { "m": "ui.key", "keys": "Escape" },
    { "m": "ui.click", "target": "Receitas" },
    { "m": "ui.type", "text": "Rust" },
    { "m": "ui.click", "target": "Executar" },
    { "m": "ui.click", "target": "Aprovar este conteúdo" },
    { "m": "ui.key", "keys": "Escape" },
    { "m": "ui.snapshot" }
  ],
  "expect": [
    { "step": 8, "present": "Rodar receita?", "window_count": 1 },
    { "step": 9, "absent": "Rodar receita?", "window_count": 0 }
  ]
}
