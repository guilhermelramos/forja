{
  "title": "Diferenças mostra erro do Git de forma humana, sem texto cru (#180)",
  "issue": 180,
  "locale": "pt-BR",
  "test_helpers": "none",
  "steps": [
    { "m": "ui.key", "keys": "Escape" },
    { "m": "ui.click", "target": "Abrir pasta" },
    { "m": "ui.click", "target": "Escolher…" },
    { "m": "ui.click", "target": "Adicionar" },
    { "m": "ui.wait", "ms": 1200 },
    { "m": "ui.click", "target": "Diferenças" },
    { "m": "ui.click", "target": "Mudança anterior" },
    { "m": "ui.click", "target": "Em linha" },
    { "m": "ui.click", "target": "Ignorar espaço" },
    { "m": "ui.snapshot" }
  ],
  "expect": [
    {
      "step": 9,
      "present_contains": ["Diferenças"],
      "absent_contains": [
        "rev-parse",
        "Needed a single revision",
        "fatal:",
        "git rev-parse",
        "os error"
      ]
    }
  ]
}
