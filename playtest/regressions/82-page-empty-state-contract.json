{
  "title": "Rotinas e Mutirão sem dados usam o mesmo texto e papel de estado vazio (#197)",
  "issue": 197,
  "locale": "pt-BR",
  "test_helpers": "none",
  "steps": [
    {
      "m": "ui.key",
      "keys": "Escape"
    },
    {
      "m": "ui.click",
      "target": "Rotinas"
    },
    {
      "m": "ui.wait",
      "ms": 600
    },
    {
      "m": "ui.snapshot"
    },
    {
      "m": "ui.click",
      "target": "Mutirão"
    },
    {
      "m": "ui.wait",
      "ms": 600
    },
    {
      "m": "ui.snapshot"
    }
  ],
  "expect": [
    {
      "step": 3,
      "present_elements": [
        {
          "name": "Ainda não há itens.",
          "role": "Label"
        }
      ],
      "no_geometry_issues": true
    },
    {
      "step": 6,
      "present_elements": [
        {
          "name": "Ainda não há itens.",
          "role": "Label"
        }
      ],
      "no_geometry_issues": true
    }
  ]
}
